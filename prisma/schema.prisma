generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  email         String?   @unique
  name          String?
  password      String?
  image         String?
  emailVerified DateTime?
  // Primary auth method: credentials | google
  provider      String?   @default("credentials")

  // --- Plan & usage (SmartCV subscription system) ---
  plan                  String    @default("free") // free | student | basic | pro
  cvUsed                Int       @default(0)
  aiUsed                Int       @default(0)
  cvLimit               Int       @default(20)
  studentVerified       Boolean   @default(false)
  studentId             String?
  verificationStatus    String    @default("none") // none | pending | verified | rejected
  studentEmailDomain    String?

  // --- Admin & Paddle billing ---
  role                  String    @default("user") // user | admin
  paddleSubscriptionId  String?   @unique
  paddleCustomerId      String?
  paddleSubscriptionStatus String? @default("inactive")

  stripeCustomerId             String?   @unique
  stripeSubscriptionId         String?   @unique
  stripePriceLookupKey         String?
  subscriptionStatus           String?   @default("inactive")
  subscriptionPlan             String?   @default("free")
  subscriptionCurrentPeriodEnd DateTime?

  accounts Account[]
  sessions Session[]
  cvs      CV[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CV {
  id         Int      @id @default(autoincrement())
  userId     Int
  title      String   @default("Untitled CV")
  templateId Int      @default(1)
  status     String   @default("draft")
  // Serialized JSON payload (sections, metadata, generatorData, etc.).
  // SQLite has no native JSON type — parse/stringify at the boundary.
  data       String   @default("{}")
  atsScore   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
}

// Pre-written CV samples that users can preview and clone into their builder.
// Generated mostly by an offline script (see `scripts/generate-cv-samples.ts`)
// with a smaller hand-curated seed for quality and offline parity.
model CVSample {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  title      String
  role       String
  industry   String
  seniority  String   // "junior" | "mid" | "senior" | "executive"
  language   String   // ISO-639 short tag: "en" | "az" | "ru"
  summary    String
  // Serialized JSON: { sections: { personal, summary, experience[], education[], skills[], languages?[], certificates?[] } }
  data       String
  tags       String   @default("[]") // JSON array of free-text tags
  popularity Int      @default(0)
  source     String   @default("seed") // "seed" | "ai" | "manual"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([industry])
  @@index([seniority])
  @@index([language])
  @@index([industry, seniority, language])
}
