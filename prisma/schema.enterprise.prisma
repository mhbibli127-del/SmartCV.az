// Enterprise production schema — PostgreSQL (Supabase)

generator client {
provider = "prisma-client-js"
}

datasource db {
provider  = "postgresql"
url       = env("DATABASE_URL")
directUrl = env("DIRECT_URL")
}

// ─── Auth & Users ───────────────────────────────────────────────────────────

model User {
id            String    @id @default(cuid())
email         String    @unique
name          String?
passwordHash  String?
image         String?
emailVerified DateTime?
provider      String    @default("credentials")
role          UserRole  @default(USER)

locale        String    @default("en")
theme         String    @default("system")
timezone      String?

aiUsed        Int       @default(0)
aiTokenBudget Int       @default(0)

paddleCustomerId   String? @unique
studentVerified    Boolean @default(false)
studentId          String?
verificationStatus VerificationStatus @default(NONE)

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
deletedAt DateTime?

accounts      Account[]
sessions      Session[]
resumes       Resume[]
subscriptions Subscription[]

@@index([email])
@@index([role])
@@map("users")
}

enum UserRole {
USER
EDITOR
ADMIN
SUPER_ADMIN
}

enum VerificationStatus {
NONE
PENDING
VERIFIED
REJECTED
}

model Account {
id                String  @id @default(cuid())
userId            String
type              String
provider          String
providerAccountId String
refresh_token     String? @db.Text
access_token      String? @db.Text
expires_at        Int?
token_type        String?
scope             String?
id_token          String? @db.Text
session_state     String?

user User @relation(fields: [userId], references: [id], onDelete: Cascade)

@@unique([provider, providerAccountId])
@@map("accounts")
}

model Session {
id           String   @id @default(cuid())
sessionToken String   @unique
userId       String
expires      DateTime

user User @relation(fields: [userId], references: [id], onDelete: Cascade)

@@map("sessions")
}

model VerificationToken {
identifier String
token      String   @unique
expires    DateTime

@@unique([identifier, token])
@@map("verification_tokens")
}

// ─── Billing ────────────────────────────────────────────────────────────────

model Subscription {
id                   String             @id @default(cuid())
userId               String
plan                 String             @default("free")
status               SubscriptionStatus @default(INACTIVE)
paddleSubscriptionId String?            @unique
currentPeriodEnd     DateTime?
cancelAtPeriodEnd    Boolean            @default(false)

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

user User @relation(fields: [userId], references: [id], onDelete: Cascade)

@@index([userId])
@@map("subscriptions")
}

enum SubscriptionStatus {
ACTIVE
INACTIVE
PAST_DUE
CANCELED
TRIALING
}

// ─── Templates ──────────────────────────────────────────────────────────────

model Template {
id           String   @id @default(cuid())
title        String
slug         String   @unique
category     String
description  String?  @db.Text
thumbnailUrl String?
previewUrl   String?
isPremium    Boolean  @default(false)
isPublic     Boolean  @default(true)
usageCount   Int      @default(0)

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

resumes Resume[]

@@index([category])
@@map("templates")
}

// ─── Resume System ──────────────────────────────────────────────────────────

model Resume {
id         String       @id @default(cuid())
userId     String
title      String       @default("Untitled CV")
slug       String?
status     ResumeStatus @default(DRAFT)
templateId String?

content    Json         @default("{}")
canvasData Json?

atsScore   Int?
language   String       @default("en")

isPublic   Boolean      @default(false)
viewCount  Int          @default(0)

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
deletedAt DateTime?

user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
template Template? @relation(fields: [templateId], references: [id])

versions ResumeVersion[]
exports  ExportRecord[]
comments Comment[]

@@index([userId])
@@index([templateId])
@@map("resumes")
}

enum ResumeStatus {
DRAFT
COMPLETED
ARCHIVED
}

model ResumeVersion {
id         String   @id @default(cuid())
resumeId   String
version    Int
content    Json
canvasData Json?

createdAt DateTime @default(now())

resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

@@unique([resumeId, version])
@@map("resume_versions")
}

// ─── AI ─────────────────────────────────────────────────────────────────────

model AIGeneration {
id           String   @id @default(cuid())
userId       String
resumeId     String?

model        String
pipeline     String

inputTokens  Int      @default(0)
outputTokens Int      @default(0)

status       AIJobStatus @default(PENDING)

input        Json?
output       Json?

createdAt DateTime @default(now())
completedAt DateTime?

user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
resume Resume? @relation(fields: [resumeId], references: [id])

@@index([userId])
@@index([status])
@@map("ai_generations")
}

enum AIJobStatus {
PENDING
RUNNING
COMPLETED
FAILED
}

// ─── Export System ──────────────────────────────────────────────────────────

model ExportRecord {
id       String       @id @default(cuid())
userId   String
resumeId String

format   ExportFormat
status   ExportStatus @default(PENDING)

fileUrl  String?

createdAt DateTime @default(now())

user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

@@map("export_records")
}

enum ExportFormat {
PDF
PNG
DOCX
HTML
}

enum ExportStatus {
PENDING
PROCESSING
COMPLETED
FAILED
}

// ─── Collaboration ──────────────────────────────────────────────────────────

model Comment {
id        String   @id @default(cuid())
resumeId  String
userId    String

body      String   @db.Text

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

@@map("comments")
}

// ─── Analytics ──────────────────────────────────────────────────────────────

model AnalyticsEvent {
id        String   @id @default(cuid())

userId    String?
eventType String
page      String?

metadata  Json?

createdAt DateTime @default(now())

@@index([eventType])
@@map("analytics_events")
}

// ─── Notifications ──────────────────────────────────────────────────────────

model Notification {
id        String   @id @default(cuid())
userId    String

type      String
title     String
body      String? @db.Text

read      Boolean @default(false)

createdAt DateTime @default(now())

user User @relation(fields: [userId], references: [id], onDelete: Cascade)

@@index([userId, read])
@@map("notifications")
}

// ─── Queue Jobs ─────────────────────────────────────────────────────────────

model QueueJob {
id          String   @id @default(cuid())
queue       String
type        String
payload     Json

status      QueueJobStatus @default(PENDING)

attempts    Int @default(0)

createdAt DateTime @default(now())

@@index([queue, status])
@@map("queue_jobs")
}

enum QueueJobStatus {
PENDING
RUNNING
COMPLETED
FAILED
}
