# SmartCV.AZ — required environment variables (copy to .env.local)

# ── Vercel production ─────────────────────────────────────────────
# NEXTAUTH_URL=https://smartcv.vercel.app
# NEXT_PUBLIC_APP_URL=https://smartcv.vercel.app
# DATABASE_URL=postgresql://...pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://...supabase.co:5432/postgres
# CLOUDINARY_* required for PDF/thumbnail persistence on Vercel
# Run: npm run verify:vercel
# See: docs/VERCEL-DEPLOY.md

# Database — Supabase PostgreSQL (Prisma)
# 1. Supabase → Project Settings → Database → Connection string
# 2. DATABASE_URL = "Transaction" pooler, port 6543, add ?pgbouncer=true
# 3. DIRECT_URL   = "Direct connection", host db.PROJECT_REF.supabase.co, port 5432
# 4. URL-encode password special chars (@ → %40)
# 5. prisma/.env is auto-generated from .env.local (scripts/load-env.mjs)
# If you see ECIRCUITBREAKER: reset DB password in Supabase, wait 5–15 min, update both URLs
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
JWT_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Keep development locally — do NOT set production in .env.local (breaks cookies/devtools)
NODE_ENV=development

# Email (optional — OTP / notifications)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Storage (optional — image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sentry (optional — omit entirely to disable; no SDK warnings when unset)
# DSN: Project Settings → Client Keys (DSN). Use same value for both vars on Vercel.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Source maps + releases (Vercel Production only — never commit the token)
# Create token: Sentry → Settings → Auth Tokens → project:releases + org:read
SENTRY_AUTH_TOKEN=
SENTRY_ORG=smartcv-99
SENTRY_PROJECT=javascript-nextjs
# Auto-set on Vercel: VERCEL_GIT_COMMIT_SHA. Override manually if needed:
# SENTRY_RELEASE=

# MongoDB (optional — legacy routes; app works without it)
MONGODB_ENABLED=false
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&authSource=admin"
