# SmartCV.AZ — required environment variables (copy to .env.local)

# ── Vercel production ─────────────────────────────────────────────
# NEXTAUTH_URL=https://your-app.vercel.app
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# DATABASE_URL=postgresql://...pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://...supabase.co:5432/postgres
# CLOUDINARY_* required for PDF/thumbnail persistence on Vercel
# Run: npm run verify:vercel
# See: docs/VERCEL-DEPLOY.md

# Database (PostgreSQL via Supabase or similar)
# DATABASE_URL = Session pooler (port 6543, ?pgbouncer=true)
# DIRECT_URL   = Direct connection (port 5432) — required for migrations
# If you see ECIRCUITBREAKER: wrong password or too many retries — reset in Supabase dashboard
# Prisma reads prisma/.env (auto-synced from .env.local via npm scripts / postinstall)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Direct connection (port 5432) — required for migrations; can match DATABASE_URL locally
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
JWT_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Keep development locally — do NOT set production in .env.local (breaks cookies/devtools)
NODE_ENV=development

# AI (optional — CV generator / copilot)
OPENAI_API_KEY=

# Email (optional — OTP / notifications)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Storage (optional — image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Analytics (optional — Project API Key from PostHog → Project Settings, starts with phc_)
# US: NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# EU: NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_ENABLED=true
NEXT_PUBLIC_POSTHOG_KEY=phc_qALhs6A7QNB7TLqVhVbEHXMMuotDGvsAR6RXmz4Tc2L9
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (optional — omit entirely to disable; no SDK warnings when unset)
# DSN: Project Settings → Client Keys (DSN). Use same value for both vars on Vercel.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Source maps + releases (Vercel Production only — never commit the token)
# Create token: Sentry → Settings → Auth Tokens → project:releases + org:read
SENTRY_AUTH_TOKEN=
SENTRY_ORG=smartcv-99
SENTRY_PROJECT=javascript-nextjs
# Auto-set on Vercel: VERCEL_GIT_COMMIT_SHA. Override manually if needed:
# SENTRY_RELEASE=

# MongoDB (optional — legacy CV routes; leave empty if unused)
MONGODB_URI=
